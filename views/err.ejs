<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Error | CineLog</title>
    <!-- Outfit Font & Bootstrap -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="error-page">
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="col-md-6 col-lg-5">
            <div class="glass-card text-center p-5">
                <div class="error-icon-wrapper mb-4">
                    <span class="error-icon">!</span>
                </div>
                <h1 class="fw-bold mb-3 gold-text">System Interrupted</h1>
                <p class="text-secondary-muted mb-4">Something went wrong while retrieving or modifying your movie data. Please check your server console or database status.</p>
                <a href="/" class="btn btn-gold px-4 py-2">
                    <span class="btn-text">Return Home</span>
                </a>
            </div>
        </div>
    </div>
</body>
</html>
