<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Movie | CineLog</title>
    <!-- Outfit Font & Bootstrap -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page-overlay">
        <div class="container py-5">
            <div class="row justify-content-center align-items-center min-vh-100">
                <div class="col-lg-6 col-md-8 col-sm-12">
                    <div class="glass-card">
                        <div class="card-header-custom text-center">
                            <h1 class="form-title">Add to Collection</h1>
                            <p class="form-subtitle">Record and curate your cinematic treasury</p>
                        </div>

                        <form id="movieForm" action="/add-movie" method="POST" enctype="multipart/form-data" class="custom-form mt-4">
                            <div class="form-group mb-3">
                                <label for="title" class="form-label-custom">Movie Title</label>
                                <input type="text" id="title" name="title" class="form-control-custom" placeholder="Enter movie title...">
                            </div>

                            <div class="form-group mb-3">
                                <label for="genre" class="form-label-custom">Genre</label>
                                <input type="text" id="genre" name="genre" class="form-control-custom" placeholder="e.g., Action, Sci-Fi, Drama...">
                            </div>

                            <div class="form-group mb-3">
                                <label for="releaseYear" class="form-label-custom">Release Year</label>
                                <input type="number" id="releaseYear" name="releaseYear" class="form-control-custom" placeholder="e.g., 2024">
                            </div>

                            <div class="form-group mb-4">
                                <label for="poster" class="form-label-custom">Movie Poster</label>
                                <div class="file-upload-wrapper">
                                    <input type="file" id="poster" name="poster" class="file-upload-input" accept="image/*">
                                    <div class="file-upload-mask">
                                        <span class="upload-text" id="fileNamePlaceholder">Select poster image...</span>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-gold w-100 py-3 mb-3">
                                <span class="btn-text">Add Movie</span>
                            </button>

                            <a href="/view-movies" class="btn btn-outline-gold w-100 py-3">
                                <span class="btn-text">Browse Collection</span>
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Update file name placeholder on file select
        const posterInput = document.getElementById("poster");
        const placeholder = document.getElementById("fileNamePlaceholder");

        posterInput.addEventListener("change", (e) => {
            if (e.target.files.length > 0) {
                placeholder.textContent = e.target.files[0].name;
                placeholder.classList.add("file-selected");
            } else {
                placeholder.textContent = "Select poster image...";
                placeholder.classList.remove("file-selected");
            }
        });

        // Form validation
        document.getElementById("movieForm").addEventListener("submit", (e) => {
            const title = document.getElementById("title").value.trim();
            const genre = document.getElementById("genre").value.trim();
            const year = document.getElementById("releaseYear").value;
            const poster = document.getElementById("poster").files.length;

            if (!title || !genre || !year || !poster) {
                alert("All fields are required.");
                e.preventDefault();
                return;
            }

            if (year.length !== 4) {
                alert("Release year must be 4 digits.");
                e.preventDefault();
                return;
            }
        });
    </script>
</body>
</html>
