<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Collection | CineLog</title>
    <!-- Outfit Font & Bootstrap -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page-overlay py-5">
        <div class="container-lg">
            
            <!-- Page Header -->
            <div class="row align-items-center mb-5">
                <div class="col-md-8 text-center text-md-start">
                    <h1 class="page-title text-white">Cinematic Collection</h1>
                    <p class="page-subtitle">Curated treasury of cataloged titles</p>
                </div>
                <div class="col-md-4 text-center text-md-end mt-4 mt-md-0">
                    <a href="/" class="btn btn-gold px-4 py-3">
                        <span class="btn-text">+ Add New Movie</span>
                    </a>
                </div>
            </div>

            <!-- Movies Grid -->
            <% if (movies.length === 0) { %>
                <div class="row justify-content-center py-5">
                    <div class="col-md-6 text-center">
                        <div class="empty-state-wrapper p-5 glass-card">
                            <h3 class="gold-text mt-3">Vault is Empty</h3>
                            <p class="text-secondary-muted">You haven't cataloged any movies yet. Tap the button above to add your first movie poster and metadata.</p>
                            <a href="/" class="btn btn-outline-gold mt-3 px-4">Catalog First Movie</a>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="row g-4">
                    <% movies.forEach(movie => { %>
                        <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                            <div class="movie-card-custom">
                                <!-- Card Image Wrapper -->
                                <div class="movie-poster-wrapper">
                                    <img src="/<%= movie.poster %>" alt="<%= movie.title %>" class="movie-poster-img" loading="lazy">
                                    <div class="movie-poster-overlay">
                                        <div class="movie-tag-genre"><%= movie.genre %></div>
                                        <div class="movie-tag-year"><%= movie.releaseYear %></div>
                                    </div>
                                </div>
                                
                                <!-- Card Details -->
                                <div class="movie-card-details">
                                    <h4 class="movie-card-title text-white" title="<%= movie.title %>">
                                        <%= movie.title %>
                                    </h4>
                                    <div class="movie-card-info text-secondary-muted d-flex justify-content-between mb-3">
                                        <span><%= movie.genre %></span>
                                        <span class="gold-text fw-bold"><%= movie.releaseYear %></span>
                                    </div>
                                    
                                    <!-- Action Buttons -->
                                    <div class="movie-card-actions gap-2">
                                        <a href="/edit-movie/<%= movie._id %>" class="btn-card btn-card-edit" title="Edit movie details">
                                            Edit Details
                                        </a>
                                        <a href="/delete-movie/<%= movie._id %>" class="btn-card btn-card-delete" onclick="return confirm('Are you sure you want to remove this movie from your vault?')" title="Delete movie poster and metadata">
                                            Delete
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

        </div>
    </div>
</body>
</html>
